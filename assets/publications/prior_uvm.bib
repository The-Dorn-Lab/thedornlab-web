@article{bergmann2019_catalystcontrolled,
  title = {Catalyst-{{Controlled}} 1,2- and 1,1-{{Arylboration}} of {$\alpha$}-{{Alkyl Alkenyl Arenes}}},
  author = {Bergmann, Allison M. and Dorn, Stanna K. and Smith, Kevin B. and Logan, Kaitlyn M. and Brown, M. Kevin},
  year = 2019,
  month = jan,
  journal = {Angew. Chem. Int. Ed.},
  volume = {58},
  number = {6},
  pages = {1719--1723},
  issn = {1521-3773},
  doi = {10.1002/anie.201812533},
  urldate = {2026-10-10},
  abstract = {Two methods are reported for the 1,2- and 1,1-arylboration of {$\alpha$}-methyl vinyl arenes. In the case of 1,2-arylboration, the formation of a quaternary center occurred through a rare cross-coupling reaction of a tertiary organometallic complex. 1,1-Arylboration was enabled by catalyst optimization and occurred through a {$\beta$}-hydride elimination/reinsertion cascade. Enantioselective variants of both processes are presented as well as mechanistic investigations.},
  copyright = {\copyright{} 2019 Wiley-VCH Verlag GmbH \& Co. KGaA, Weinheim},
  langid = {english},
  keywords = {carboboration,copper,cross-coupling,homogeneous catalysis,palladium},
  note = {\url{https://onlinelibrary.wiley.com/doi/abs/10.1002/anie.201812533}},
  file = {C\:\\Users\\jsirl\\Zotero\\storage\\VL2XUHPA\\Bergmann et al. - 2019 - Catalyst-Controlled 1,2- and 1,1-Arylboration of α-Alkyl Alkenyl Arenes.pdf;C\:\\Users\\jsirl\\Zotero\\storage\\C7PG8H4S\\anie.html}
}

@article{das2025_approach,
  title = {Approach {{Toward Stereoselective}} {$\alpha$}-{{Arylation}} by {{Pd}}/{{Cu-Catalyzed Arylboration}} of {{Electron Deficient Alkenes}}},
  author = {Das, Suman and Reilly, Maeve A. and Dorn, Stanna K. and Pearson, Allison M. and Brown, M. Kevin},
  year = 2025,
  month = may,
  journal = {Angew. Chem. Int. Ed.},
  volume = {64},
  number = {22},
  pages = {e202424073},
  issn = {1521-3773},
  doi = {10.1002/anie.202424073},
  urldate = {2026-10-10},
  abstract = {Palladium-catalyzed cross coupling of enolates---{$\alpha$}-arylation---is an established method for chemical synthesis. A major challenge in the field is control of stereochemistry for the {$\alpha$}-carbon. This is typically due to facile epimerization under the basic reaction conditions for {$\alpha$}-arylation. In this study, an alternative approach is presented that involves the Pd/Cu-catalyzed arylboration of electron deficient alkenes. The products are generated with high levels of diastereoselectivity for a broad range of substitution patterns. Enantioselective variants are also presented in addition to product derivatizations.},
  langid = {english},
  keywords = {Alkene,Boron,Carboboration,Copper,Palladium},
  note = {\url{https://onlinelibrary.wiley.com/doi/abs/10.1002/anie.202424073}},
  file = {C\:\\Users\\jsirl\\Zotero\\storage\\YBN9U4QC\\Das et al. - 2025 - Approach Toward Stereoselective α-Arylation by PdCu-Catalyzed Arylboration of Electron Deficient Al.pdf;C\:\\Users\\jsirl\\Zotero\\storage\\TRHIUD4Q\\anie.html}
}

@article{das2026_stereodivergent,
  title = {Stereodivergent {{Synthesis}} of {{Three Contiguous Stereogenic Centers}} by {{Cu}}/{{Ir-Catalyzed Borylallylation}}},
  author = {Das, Suman and Dorn, Stanna K. and Brown, M. Kevin},
  year = 2026,
  month = feb,
  journal = {Angew. Chem. Int. Ed.},
  volume = {65},
  number = {8},
  pages = {e23140},
  issn = {1521-3773},
  doi = {10.1002/anie.202523140},
  urldate = {2026-10-10},
  abstract = {Polyfunctional compounds bearing multiple stereogenic centers are synthetically valuable and important for complex molecule preparation. Herein, a Cu/Ir-catalyzed borylallylation of electron deficient alkenes is presented. The reaction operates by the cooperative function of a chiral Cu-complex and a chiral Ir-complex to generate products with high levels of stereocontrol. The method also allows for the stereodivergent synthesis of acyclic products with control of three stereogenic centers. Importantly, the products contain C-B, ester, and alkene functionalities, which allows for a diverse range of products to be generated. Finally, the highly functional nature of the products has been exploited in an efficient formal synthesis of the complex natural product (+)-({$\beta$})-Lycorane.},
  copyright = {\copyright{} 2025 The Author(s). Angewandte Chemie International Edition published by Wiley-VCH GmbH},
  langid = {english},
  keywords = {-Lycorane,Alkene difunctionalization,Carboallylation,Carboboration,Cooperative catalysis,Stereodivergent synthesis},
  note = {\url{https://onlinelibrary.wiley.com/doi/abs/10.1002/anie.202523140}},
  file = {C\:\\Users\\jsirl\\Zotero\\storage\\CZHZHEH8\\Das et al. - 2026 - Stereodivergent Synthesis of Three Contiguous Stereogenic Centers by CuIr-Catalyzed Borylallylation.pdf;C\:\\Users\\jsirl\\Zotero\\storage\\5VBWFS7Y\\anie.html}
}

