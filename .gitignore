# the pages show are uploaded as normal.
assets/research_schemes/*/
*.ai
*.cdxml
*.psd
assets/dornlab_icon.png
assets/dornlab_logo.png
assets/dornlab_icon_outlined_opaque.svg
assets/dornlab_icon_outlined_thick_translucent.svg

